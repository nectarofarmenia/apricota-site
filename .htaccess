# Force HTTPS and the bare domain
RewriteEngine On
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://apricota.am%{REQUEST_URI} [L,R=301]
DirectoryIndex index.html
# The admin: apricota.am/admin is the same page, signed in with the Chef Apri Work account
RewriteRule ^admin/$ /admin [R=301,L]
RewriteRule ^admin$ /index.html [L]
Options -Indexes
# Never serve hidden or backup files
<FilesMatch "^\.|\.(bak|sql|log|env)$">
  Require all denied
</FilesMatch>

AddType application/manifest+json .webmanifest
AddType image/x-icon .ico
# Notes for developers are not part of the site
<FilesMatch "\.md$">
  Require all denied
</FilesMatch>
